---
/* The footer. The sk credit comes from @shaahink/sitekit/credits so the whole
   fleet's credit line changes together — the visible anchor plus the
   schema.org JSON-LD naming sk as the site's creator (PLAN §3.3).
   Presentation stays with the site: style .sk-credit however the design
   wants, but the anchor itself is always the kit's. */
import { creditsFor } from "@shaahink/sitekit/credits";
import { absolute } from "@shaahink/sitekit/seo";

/* Whose site this is, for the copyright line and for the JSON-LD the credit
   emits. It matches README's licence line rather than the wordmark: "field
   guide" is what the site is called, and this line is about who owns the
   words. The template shipped "New Site" here and `checkPlaceholders` never
   saw it — the gate reads the `editable` map, and a name written into a
   component is not content. It was on every page of the built site for three
   sessions (S1.4).

   The url is derived, not stated: astro.config's `site` is the only place the
   origin lives, so a domain change never touches this file. */
const site = { name: "Shahin Kiassat", url: absolute(Astro.site!) };

/* The whole credit sentence is the kit's since 0.23.0 — a site no longer
   writes the words around the name — and since 0.24.0 it is English on every
   site whatever language the page is in. There is nothing to pass and nothing
   to translate: it is the studio's signature, not the page's speech. */
const credit = creditsFor({ siteName: site.name, siteUrl: site.url });
---

<footer>
  {/* The orientation pages live here rather than in the top bar, on the same
      reasoning /tags/ wrote down for itself: the three sections are the site's
      shape, and a bar with five things in it would say the shape is five.
      These are destinations — the words, the intent, the second way through —
      and the footer is where a reader who has run out of page goes looking. */}
  <nav aria-label="Also on this site">
    <a href="/conductor/">Conductor</a>
    <a href="/glossary/">Glossary</a>
    <a href="/roadmap/">Roadmap</a>
    <a href="/tags/">Tags</a>
  </nav>
  {/* How to reach the person whose month this was (owner's ask, 2026-08-13).
      Real addresses, in the component rather than in content — the same
      placement as the credit line, because who wrote the site and how to
      reach them are the same kind of fact. The mail link is written out
      rather than hidden behind a word: a reader deciding whether to write
      wants to see the address, and a footer is where they look for it. */}
  <nav class="contact" aria-label="Contact">
    <a href="mailto:shaahin69@gmail.com">shaahin69@gmail.com</a>
    <a href="https://github.com/shaahink" rel="me">github.com/shaahink</a>
  </nav>
  <p>&copy; <span id="current-year"></span> {site.name} · <Fragment set:html={credit} /></p>
</footer>

<script>
  const year = document.getElementById("current-year");
  if (year) year.textContent = String(new Date().getFullYear());
</script>

<style>
  /* The footer had no face at all — a flush, unpadded line under whatever the
     page ended with. A hairline and the same small-and-muted register as every
     other caption on the site closes the page instead of stopping it. */
  footer {
    margin-block-start: var(--space-3xl);
    border-block-start: var(--rule);
    padding-block: var(--space-l);
    padding-inline: var(--space-m);
    font-size: var(--text-small);
    color: var(--muted);
  }

  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-end: var(--space-s);
  }

  /* The addresses are machine-shaped strings, so they wear the mono the rest
     of the site reserves for machine truth — an address either works verbatim
     or it does not, which is the same promise. */
  footer .contact a {
    font-family: var(--mono);
    font-size: var(--text-micro);
  }

  footer nav a {
    color: var(--muted);
    text-decoration: none;
  }

  footer nav a:hover {
    color: var(--text);
  }
</style>
