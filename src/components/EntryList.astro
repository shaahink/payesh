---
/* The list an index page is. Three sections use it and it is the same list in
   all three, because a reader crossing from /concepts/ to /runs/ should not
   have to learn a second way of reading a list.

   No `data-sk-edit` in here, deliberately. The strings shown are other
   entries' titles, and an index page declares one collection and one entry to
   the editor — the section page whose own copy it is showing. Annotating a
   neighbour's title would point the editor at the wrong file, which is the one
   mistake the inline editor must not make easy. Titles are edited on the page
   they belong to. */
export interface Item {
  href: string;
  /** Its place in the reading order, shown so the spine is visible. Absent on
      a list that is not a sequence — see `kind`. */
  order?: number;
  title: string;
  /** One line: a concept's `oneLine`, a piece's `standfirst`, a report's
      `scenario`. Different fields, the same job. */
  summary: string;
  /** Which section this entry lives in — "Concept", "Run report".
      ---------------------------------------------------------------------
      For lists that deliberately mix the three collections: a tag page, and
      the front page's spread. There, a position number would be a lie (third
      of what?) and the orienting fact is the *kind* instead. A list is one or
      the other, never both, which is why they are separate optional fields
      rather than one labelled slot. */
  kind?: string;
}

interface Props {
  items: Item[];
  /** How the numbers read aloud, for a screen reader that would otherwise get
      a bare digit before every title. Only meaningful on a numbered list. */
  ordinalLabel?: string;
}

const { items, ordinalLabel } = Astro.props;

/* An ordered list only where the order is a fact about the content. A tag page
   is a set — its entries have no first and no third — and `<ol>` would tell a
   screen reader otherwise in the one place a sighted reader gets no such
   impression. Astro cannot switch the tag name on an expression, so the two
   branches are written out. */
const numbered = items.some((item) => item.order !== undefined);
---

{
  numbered ? (
    <ol class="rule-list entries">
      {items.map((item) => (
        <li>
          <a href={item.href}>
            <span class="ordinal">
              <span class="visually-hidden">{ordinalLabel} </span>
              {item.order}
            </span>
            <span class="entry-title">{item.title}</span>
          </a>
          <p>{item.summary}</p>
        </li>
      ))}
    </ol>
  ) : (
    <ul class="rule-list entries">
      {items.map((item) => (
        <li>
          {item.kind && <span class="eyebrow kind">{item.kind}</span>}
          <a href={item.href}>
            <span class="entry-title">{item.title}</span>
          </a>
          <p>{item.summary}</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .entries a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--text);
  }

  /* Mono, because the number is a position in a sequence rather than a word —
     the same reason every other machine fact on this site is mono. */
  .ordinal {
    font-family: var(--mono);
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* The section label on a mixed list is the site's `.eyebrow` — this used to
     be a fourth hand-copy of its five declarations, under a comment claiming
     it was "set like every other eyebrow on the site", which is exactly the
     comment you write while the copies are drifting. What is left is the two
     things that are about this list rather than about eyebrows: it goes above
     the title rather than beside it, so the titles still line up down the
     left edge and the list scans as a list. */
  .kind {
    display: block;
    margin-block-end: var(--space-3xs);
  }

  .entry-title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
  }

  .entries a:hover .entry-title {
    color: var(--current);
  }

  .entries p {
    color: var(--muted);
    margin-block-start: var(--space-3xs);
  }
</style>
