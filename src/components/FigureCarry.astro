---
/* What one session hands the next — the carry that compounds, and the rent
   that does not.
   ---------------------------------------------------------------------------
   Two sessions with a boundary between them. Session one worked something
   out; whether session two starts knowing it is the toggle, and the cost of
   not knowing is drawn as the same dead end walked twice. The other button
   is the concept's second half: memory is paid for on the far side, so a
   perfectly true status paragraph is a line every later prompt re-reads for
   nothing — added here one press at a time, so the reader can watch the
   worthless part of the file grow past the worthwhile part. */
---

<figure class="fig fig-carry" data-fig="carry">
  <div
    class="drawing"
    role="img"
    aria-label="Two agent sessions separated by a boundary. Session one rules an approach out and writes the rule down; session two is a different process that starts empty except for what was written. With the note carried, session two skips the dead end. Without it, session two tries the same approach, spends the same money, and reaches the same dead end. Every line carried is also re-read by every later session — so a status paragraph, however true, is rent paid on every prompt for a line that changes nothing."
  >
    <div class="panes" aria-hidden="true">
      <div class="pane session">
        <span class="fig-label">session 1</span>
        <p class="fig-note">tried the obvious fix — it does not work here, and now it knows why</p>
        <p class="wrote mono" data-wrote>wrote: "the obvious fix fails — the flag is ignored; go around"</p>
      </div>
      <div class="boundary">
        <span class="fig-label">the boundary</span>
        <span class="fig-note">a different process — nothing crosses unless it was written</span>
      </div>
      <div class="pane session">
        <span class="fig-label">session 2 — its prompt opens with</span>
        <ul class="carried" data-carried>
          <li class="rule-line">"the obvious fix fails — the flag is ignored; go around"</li>
        </ul>
        <p class="outcome fig-note" data-outcome>
          skips the dead end and starts on the way around — the carry earned its rent
        </p>
      </div>
    </div>
  </div>

  <div class="fig-controls">
    <button type="button" class="fig-btn" data-act="skip" aria-pressed="false">
      write nothing down
    </button>
    <button type="button" class="fig-btn" data-act="status">add a status paragraph</button>
    <button type="button" class="fig-btn" data-act="reset">reset</button>
    <p class="fig-status" data-status aria-live="polite">
      Take the note away, or pad the memory, and watch what session 2 pays.
    </p>
  </div>

  <figcaption>
    Everything a session works out dies with it unless something writes it
    down — and everything written down is read into every prompt after it.
    The question to ask of a memory is not whether it is true. It is whether
    it will change what the next session does.
  </figcaption>
</figure>

<script>
  import { spawn, wire } from "../scripts/figures.js";

  const RULE = '"the obvious fix fails — the flag is ignored; go around"';
  const STATUS_LINE = '"finished checkpoint 3; two commits; gates green"';
  const MAX_PADDING = 3;

  wire("carry", (figure) => {
    const status = figure.querySelector("[data-status]")!;
    const wrote = figure.querySelector("[data-wrote]")!;
    const carried = figure.querySelector("[data-carried]")!;
    const outcome = figure.querySelector("[data-outcome]")!;
    const skip = figure.querySelector('[data-act="skip"]')!;
    let padding = 0;

    const skipped = () => skip.getAttribute("aria-pressed") === "true";

    const render = () => {
      wrote.textContent = skipped() ? "wrote: nothing" : `wrote: ${RULE}`;
      carried.textContent = "";
      if (!skipped()) {
        carried.appendChild(spawn(figure, "li", "rule-line", RULE));
      }
      for (let i = 0; i < padding; i += 1) {
        carried.appendChild(spawn(figure, "li", "rent-line", STATUS_LINE));
      }
      if (skipped() && padding === 0) {
        carried.appendChild(
          spawn(figure, "li", "empty-line", "(empty — a clean slate, which reads as good news)")
        );
      }
      outcome.textContent = skipped()
        ? "tries the obvious fix, spends the same money, reaches the same dead end — and writes " +
          "down the same nothing"
        : "skips the dead end and starts on the way around — the carry earned its rent";
      outcome.classList.toggle("bad", skipped());
    };

    skip.addEventListener("click", () => {
      skip.setAttribute("aria-pressed", String(!skipped()));
      render();
      status.textContent = skipped()
        ? "the session was killed before anything was written — the next one rediscovers it at " +
          "full price"
        : "one line, written at the moment of learning — and the next session behaves differently";
    });

    figure.querySelector('[data-act="status"]')!.addEventListener("click", () => {
      if (padding >= MAX_PADDING) {
        status.textContent =
          "enough. the worthwhile line is now the hardest one to find — that is how memory " +
          "becomes rent";
        return;
      }
      padding += 1;
      render();
      status.textContent =
        "perfectly true, and worth nothing next week — now paid for on every prompt from here on";
    });

    figure.querySelector('[data-act="reset"]')!.addEventListener("click", () => {
      padding = 0;
      skip.setAttribute("aria-pressed", "false");
      render();
      status.textContent = "Take the note away, or pad the memory, and watch what session 2 pays.";
    });
  });
</script>

<style>
  .panes {
    display: grid;
    gap: var(--space-2xs);
  }

  @media (min-width: 64rem) {
    .panes {
      grid-template-columns: 1fr auto 1.2fr;
      align-items: stretch;
    }
  }

  .session {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .boundary {
    border-inline-start: 1px dashed var(--overlay);
    padding-inline-start: var(--space-2xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    justify-content: center;
    max-inline-size: 16rem;
  }

  .wrote {
    font-size: var(--text-micro);
    color: var(--current);
    border-block-start: var(--rule);
    padding-block-start: var(--space-2xs);
  }

  .carried {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3xs);
    font-family: var(--mono);
    font-size: var(--text-micro);
  }

  .carried li {
    border-block-start: var(--rule);
    padding-block-start: var(--space-3xs);
  }

  .carried .rule-line {
    color: var(--current);
  }

  /* Rent reads as what it is: present, paid for, and saying nothing. */
  .carried .rent-line {
    color: var(--muted);
  }

  .carried .empty-line {
    color: var(--muted);
    font-style: italic;
  }

  .outcome {
    border-block-start: var(--rule);
    padding-block-start: var(--space-2xs);
  }

  .outcome.bad {
    color: var(--yellow);
  }
</style>
