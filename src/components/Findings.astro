---
/* The front page's findings: a number, what it means, and where it is argued.
   ---------------------------------------------------------------------------
   This is the component that decides whether the front page is a contents page
   or a piece of writing. The shape is deliberately the same three moves each
   time — figure, claim, destination — because six of them in a column is the
   whole argument of the site made scannable: here is a thing the record turned
   out to say, here is the number, here is where you can check it.

   The number is set large and in the mono face, because on this site mono means
   "recomputed from the store" and this is the loudest place that promise gets
   made. Its own label sits under it in the figure's own words rather than in
   any written here — same rule as the evidence strip, for the same reason.

   No `data-sk-edit` on the figure or the label: both are the corpus's, and an
   owner editing one in a form would not get a different number, they would get
   a build that fails. The claim is written and carries its annotation. */
import { corpusFigure } from "../lib/evidence.js";
import type { Tag } from "../lib/tags.js";

export interface Finding {
  figure: string;
  claim: string;
  href: string;
  /** The destination's own title, so the link text cannot drift from it. */
  title: string;
  /** "Article", "Concept", "Run report" — which kind of page it leads to. */
  kind: string;
}

interface Props {
  items: Finding[];
  /** `data-sk-edit` path prefix for the claims — `findings.items`. */
  path: string;
}

const { items, path } = Astro.props;

const resolved = items.map((item) => ({
  ...item,
  value: corpusFigure("pages/home.yaml findings", item.figure)
}));
---

<ol class="findings">
  {
    resolved.map((item, index) => (
      <li>
        <p class="figure">
          <span class="value">{item.value.display}</span>
          <span class="label">{item.value.label}</span>
        </p>

        <p class="claim" data-sk-edit={`${path}[${index}].claim`}>
          {item.claim}
        </p>

        <p class="where">
          <a href={item.href}>
            <span class="kind">{item.kind}</span>
            <span class="title">{item.title}</span>
          </a>
        </p>
      </li>
    ))
  }
</ol>

<style>
  /* A ledger, not a card grid (2026-08-13, with the front page's ink dress):
     one finding per row, the figure in its own column on a laptop and the
     claim beside it, each row opened by a hairline. Down the figure column is
     where the eye compares the numbers, which is the comparison worth making
     — and a ledger is what this site actually is, so the front page may as
     well be set like one. One column below the site's one 64rem breakpoint. */
  .findings {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
  }

  .findings li {
    border-block-start: var(--rule);
    padding-block: var(--space-m);
  }

  @media (min-width: 64rem) {
    .findings li {
      display: grid;
      grid-template-columns: minmax(11rem, 15rem) 1fr;
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .figure {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .claim {
      grid-column: 2;
      grid-row: 1;
    }

    .where {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* The largest type on the page after the headline, and still mono, because
     mono is the promise: this number was recomputed from the store. In the
     accent — on this page the vermilion marks what a scanning eye should
     catch, and the number is the argument. */
  .value {
    display: block;
    font-family: var(--mono);
    font-size: var(--text-ledger);
    color: var(--accent);
    line-height: 1.1;
  }

  .label {
    display: block;
    font-size: var(--text-small);
    color: var(--muted);
    margin-block-start: var(--space-3xs);
  }

  .claim {
    margin-block-start: var(--space-2xs);
    color: var(--text);
    max-inline-size: var(--measure-narrow);
  }

  .where {
    margin-block-start: var(--space-xs);
  }

  .where a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    text-decoration: none;
    font-size: var(--text-small);
  }

  .kind {
    font-family: var(--mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .title {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .where a:hover .title,
  .where a:focus-visible .title {
    text-decoration-thickness: 2px;
  }
</style>
