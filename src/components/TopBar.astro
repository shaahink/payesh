---
/* The quiet top bar: wordmark, the sections, the theme toggle.

   The section list was a literal here and is not one any more (S2.2). It is
   built from `src/content/sections/` — the same three entries that carry each
   index page's own copy — and a section whose collection is still empty is
   left out. A section that exists and a section that is linked can no longer
   disagree, because there is only one list. */
import Mark from "./Mark.astro";
import { navSections } from "../lib/collections.js";

const sections = await navSections();

/* Every word the theme button can ever show. "Theme" is what the markup ships
   with, because before `theme.js` runs nothing knows which scheme is in force
   and a button that guesses is a button that lies for one frame; "Dark" and
   "Light" are what `paint()` writes.

   They are listed here so the button can be sized to the widest of them
   *before* any of them is chosen — see the grid in the style block. The list
   is the same one `src/scripts/theme.js` writes, and
   `test/theme-toggle.test.mjs` fails if the two ever disagree, because a label
   added there and not here brings the layout shift straight back. */
const LABELS = ["Theme", "Dark", "Light"];
const INITIAL = LABELS[0];

/* `aria-current="page"` on the section a reader is inside, including its
   children: /concepts/context-engineering/ is still Concepts. */
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="topbar">
  {/* The mark, the name, and then what the name means — because "Payesh"
      tells an English reader nothing on its own, and a wordmark that has to be
      looked up is a wordmark that gets ignored. Payesh is Persian for
      monitoring: watching something over time and keeping the record. It is
      what this site is. The mark draws the same two facts — a ring for the
      watching, a dot for the record — and it is the favicon's own drawing, so
      the tab and the bar agree.

      The gloss is hidden below the phone breakpoint, where the bar has room
      for a name and a theme button and nothing else. It stays in the accessible
      name at every width, so it is the screen-reader label rather than a
      decoration that disappears. */}
  <a class="wordmark" href="/">
    <Mark />
    <span class="name">Payesh</span>
    <span class="gloss">watching the work</span>
  </a>

  <nav aria-label="Sections">
    <ul>
      {
        sections.map((section) => (
          <li>
            <a href={section.href} aria-current={isCurrent(section.href) ? "page" : undefined}>
              {section.label}
            </a>
          </li>
        ))
      }
      {/* Not a section — one page, not a collection index — so it is not in
          the list the section pages build. It sits in the bar because the
          owner split the machine from the guide (2026-08-13) and a page that
          carries the whole record cannot live in the footer alone. */}
      <li>
        <a href="/conductor/" aria-current={isCurrent("/conductor/") ? "page" : undefined}>
          Conductor
        </a>
      </li>
    </ul>
  </nav>

  {/* Hidden until html.js — a toggle that cannot toggle is worse than no
      toggle, and a no-JS visitor still gets their system's scheme from the
      media query in tokens.css. The gating rule is global (styles.css)
      because Astro's scoped styles rewrite a selector that starts at <html>
      into one that can never match. */}
  {/* The live label sits in the same single grid cell as a hidden copy of
      every word the button can show — including its own, which is the part
      that is easy to get wrong and was: sizing against "the other labels"
      leaves the box exactly as wide as whatever the live label happens to say,
      because the moment the script writes `Dark` the word `Theme` is gone from
      the document and the track shrinks with it. Measured that way first, and
      the 12px shift was still there. Every candidate is a sizer; the live
      label is a fourth child that only ever paints.

      `visibility: hidden` keeps a sizer in the layout while taking it out of
      the paint and out of the accessibility tree; `aria-hidden` says so a
      second time, because a screen reader reading "Theme Dark Light" would be
      worse than the shift this fixes. */}
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch the theme">
    <span data-theme-label>{INITIAL}</span>
    {
      LABELS.map((label) => (
        <span class="sizer" aria-hidden="true">
          {label}
        </span>
      ))
    }
  </button>
</header>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-s);
    padding-inline: var(--space-m);
    border-block-end: var(--rule);
    background: var(--mantle);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .name {
    font-weight: var(--weight-bold);
  }

  /* The mark rides the bar at the name's own size. `align-self: center`
     rather than the row's baseline: an SVG has no baseline of its own, and
     left to the flex default it would hang from the line like a dropped
     letter. The colour is set so the ring follows the wordmark's hover the
     way the name does — the mark and the name are one link, and half a link
     changing colour on hover reads as two. */
  .wordmark :global(svg) {
    inline-size: 1em;
    block-size: 1em;
    align-self: center;
    color: inherit;
  }

  /* Quiet, and set in the small size the rest of the site's captions use: it is
     a translation, not a tagline, and it should read as one. */
  .gloss {
    font-size: var(--text-small);
    font-weight: var(--weight-body);
    color: var(--muted);
    letter-spacing: 0;
  }

  /* Below the phone breakpoint the bar carries a name, three sections and a
     button. The gloss is the one thing there that a reader can do without, so
     it is what goes — and it goes with `display: none` rather than by being
     dropped from the markup, because the accessible name should not change
     with the viewport. */
  @media (max-width: 30rem) {
    .gloss {
      display: none;
    }
  }

  .wordmark:hover .name,
  .wordmark:hover :global(svg) {
    color: var(--current);
  }

  nav ul {
    display: flex;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  /* One accent, used where it means something: it marks the current thing,
     which is the same job it does in the Face's own sidebar. */
  nav a[aria-current="page"] {
    color: var(--current);
    font-weight: var(--weight-medium);
  }

  /* A one-cell grid with every candidate label stacked in it. The track is
     sized to the widest word, so the button's box is settled at first paint
     and stays settled: `Theme` → `Dark` on load used to drag the whole nav
     12px, and `Dark` → `Light` another 3px on every flip. Not a JS fix — the
     script has already run by the time it could measure anything, and the
     first shift happens before it runs at all. */
  .theme-toggle {
    font: inherit;
    font-size: var(--text-small);
    color: var(--muted);
    background: none;
    border: var(--rule);
    padding-block: var(--space-3xs);
    padding-inline: var(--space-2xs);
    cursor: pointer;
    display: inline-grid;
  }

  /* Stretched, not centred, and that is the last 0.000005 of it: a centred
     span is only as wide as its own word, so swapping `Light` for `Dark`
     shrank the span from 45px to 30px and slid it 8px — inside a button that
     had stopped moving, but still a layout shift, and still reported as one.
     Stretching every child to the settled track width leaves nothing with a
     box that depends on the text in it. */
  .theme-toggle > * {
    grid-area: 1 / 1;
    text-align: center;
  }

  .theme-toggle .sizer {
    visibility: hidden;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--overlay);
  }
</style>
