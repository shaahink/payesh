---
/* Home. All prose comes from src/content — pages are the arrangement, not
   the words. That split is what makes the CMS session possible.

   The shape of this page is an argument, so it is worth stating. A front page
   for a site like this has two obvious forms and both are wrong. One is the
   pitch, which this site's whole subject rules out. The other is a contents
   page — the ten concepts as a list — which is what was here before, and which
   tells a reader what *subjects* exist without telling them a single thing that
   was learned. A stranger reads it and leaves knowing nothing.

   So the order is: what this is and who ran it, the corpus in numbers, then six
   findings — the things the month actually turned up, each with the figure
   behind it and a route to where it is argued. Then three doors, because the
   findings serve the reader who wants to know what the record said and the
   doors serve the one who arrived cold and wants to know where people like
   them start. Only after that does the page become a contents page, and by
   then the reader has a reason to use it. Near the foot, the one section
   allowed to face forward — labelled as intent, detailed on /roadmap/.

   The dress is the page's own (2026-08-13, the owner asked for a front page
   that looks like nothing inside): ink on paper — tokens.css's soot and paper
   blocks, scoped to `data-page="home"` — a display serif for the cover and the
   section heads, and پایش set large in its own script. The inner pages keep
   the Face's two schemes untouched; this page is the jacket around them, the
   way a field guide's cover is cloth while its plates are paper. What does NOT
   change with the dress: mono still means "recomputed from a run store" and
   nothing else, the semantic colours still mark status only, and every rule is
   still a rule rather than a shadow.

   Every section below reads its list from the collections rather than from a
   copy kept here. Ten titles typed onto the front page are ten titles that go
   stale the day one is renamed, and the front page is the one nobody re-reads
   — a rule this repo has already paid for once, when SPEC Part VII's front page
   requirement was owned by no checkpoint and shipped as a stub with every gate
   green on it. */
import { Font } from "astro:assets";
import { getEntry } from "astro:content";
import { isVisible } from "@shaahink/sitekit/visibility";
import EntryList from "../components/EntryList.astro";
import EvidenceStrip from "../components/EvidenceStrip.astro";
import FigureEvidence from "../components/FigureEvidence.astro";
import FigureLoop from "../components/FigureLoop.astro";
import FigureRun from "../components/FigureRun.astro";
import Findings from "../components/Findings.astro";
import RunCards from "../components/RunCards.astro";
import TagList from "../components/TagList.astro";
import Base from "../layouts/Base.astro";
import { findingTarget, hrefOf, ordered } from "../lib/collections.js";
import { allTags } from "../lib/tags.js";

const page = await getEntry("homePage", "home");
if (!page) throw new Error("src/content/pages/home.yaml is missing");
const { meta, hero, evidence, findings, machine, orient, spine, reading, runs, next, ways, notes } =
  page.data;

/* The same lists the section indexes show, read from the same place in the same
   order. Not hand-kept copies of them. */
const concepts = (await ordered("concepts")).map((entry) => ({
  href: hrefOf("concepts", entry.id),
  order: entry.data.order,
  title: entry.data.title,
  summary: entry.data.oneLine
}));

const articles = (await ordered("articles")).map((entry) => ({
  href: hrefOf("articles", entry.id),
  order: entry.data.order,
  title: entry.data.title,
  summary: entry.data.standfirst
}));

/* Run label → its report, which is what `RunCards` filters the corpus by. Built
   from the reports collection, so a fourth report appears on the front page by
   existing rather than by being added here. A report's id IS its run's
   published label — that is what makes the join possible, and `corpusIndex`
   fails the build if a label it needs is missing. */
const reports = Object.fromEntries(
  (await ordered("reports")).map((entry) => [
    entry.id,
    { href: hrefOf("reports", entry.id), title: entry.data.title }
  ])
);

/* Each finding's destination resolved against the real collections — a finding
   pointing at a renamed page fails the build here rather than publishing a dead
   link on the one page nobody re-reads. */
const items = await Promise.all(
  findings.items.map(async (item) => ({
    figure: item.figure,
    claim: item.claim,
    ...(await findingTarget(item.where))
  }))
);

/* The doors resolve the same way a finding does, for the same reason: a door
   is a promise about where a reader ends up, and a promise the build cannot
   check is a dead link waiting for a rename. */
const doors = await Promise.all(
  orient.doors.map(async (entry) => ({
    eyebrow: entry.eyebrow,
    blurb: entry.blurb,
    links: await Promise.all(entry.where.map(findingTarget))
  }))
);

/* The cover's contents rail: the sections below, by their own titles, with the
   same fixed numbers the sections print — fixed rather than renumbered, so a
   section the owner turns off leaves a gap in the count instead of silently
   renumbering everything after it and orphaning the numbers a reader already
   scrolled past. Titles come from the same bindings the sections render, so
   the rail cannot drift from the page it lists. */
type RailEntry = { no: string; href: string; label: string };
const rail: RailEntry[] = [];
if (isVisible(page.data, "findings")) rail.push({ no: "01", href: "#findings", label: findings.title });
if (isVisible(page.data, "machine")) rail.push({ no: "02", href: "#machine", label: machine.title });
if (isVisible(page.data, "orient")) rail.push({ no: "03", href: "#orient", label: orient.title });
rail.push({ no: "04", href: "#spine", label: spine.title });
rail.push({ no: "05", href: "#reading", label: reading.title });
rail.push({ no: "06", href: "#runs", label: runs.title });
if (isVisible(page.data, "next")) rail.push({ no: "07", href: "#next", label: next.title });
rail.push({ no: "08", href: "#ways", label: ways.title });
if (isVisible(page.data, "notes")) rail.push({ no: "09", href: "#notes", label: notes.title });
---

<Base
  title={meta.title}
  description={meta.description}
  ogType={meta.ogType}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  canonical={meta.canonical}
  editCollection="homePage"
  editEntry="home"
  pageId="home"
>
  {/* The cover's two faces, injected through the head slot so the twenty inner
      pages download nothing for them. Both preloaded: both paint above the
      fold — the headline immediately, the mark beside it. */}
  <Font cssVariable="--font-display" preload slot="head" />
  <Font cssVariable="--font-farsi" preload slot="head" />

  <main id="main" class="home">
    {/* `data-sk-edit` names the content path the element is showing, and sits
        beside the binding it names so it is easy to write and obvious when it
        rots. The editor checks both that the path resolves and that the
        element is showing that value verbatim — an annotation that has drifted
        says so on the page rather than silently refusing to save. */}
    <header class="cover">
      <div class="masthead">
        <div class="title">
          <h1 data-sk-edit="hero.title">{hero.title}</h1>
          <p class="tagline" data-sk-edit="hero.tagline">{hero.tagline}</p>
        </div>

        {/* The site's name in the script it is actually written in, set as the
            cover's plate. aria-hidden and out of the reading order: the top
            bar already carries the name and its gloss for every reader, and a
            screen reader announcing an Arabic-script word between the headline
            and the standfirst would be decoration read aloud. */}
        <p class="mark" lang="fa" dir="rtl" aria-hidden="true">پایش</p>
      </div>

      {
        hero.standfirst.map((para, index) => (
          <p class="standfirst" data-sk-edit={`hero.standfirst[${index}]`}>
            {para}
          </p>
        ))
      }

      {/* The contents rail: a cover is allowed to be a contents page in
          miniature — that is what the cover of a field guide is for. Numbers
          match the sections' own; labels are the sections' own titles. */}
      <nav class="contents" aria-label="On this page">
        <ol>
          {
            rail.map((entry) => (
              <li>
                <a href={entry.href}>
                  <span class="no" aria-hidden="true">{entry.no}</span>
                  <span class="sec">{entry.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    {/* SPEC Part VII requirement 2: a cold reader has to be able to see, above
        the fold, what makes this different from every other page on the topic
        — and that is the numbers, not the sentence above them. Inline rather
        than the foot variant for the same reason: at the foot it would be a
        citation, and here it is the argument. */}
    <EvidenceStrip where="pages/home.yaml" evidence={evidence} variant="inline" />

    {
      isVisible(page.data, "findings") && (
        <section id="findings">
          <p class="secnum" aria-hidden="true">01</p>
          <h2 data-sk-edit="findings.title">{findings.title}</h2>
          <p data-sk-edit="findings.intro">{findings.intro}</p>
          <Findings items={items} path="findings.items" />
        </section>
      )
    }

    {/* The two drawings — the Face's own idiom carried onto the page: panes,
        hairlines, mono labels, arrows that are characters. They sit before the
        doors because a reader who can see where "session" and "gate" live
        needs less courage to open a page that uses them. */}
    {
      isVisible(page.data, "machine") && (
        <section id="machine">
          <p class="secnum" aria-hidden="true">02</p>
          <h2 data-sk-edit="machine.title">{machine.title}</h2>
          <p data-sk-edit="machine.intro">{machine.intro}</p>
          <div class="figures">
            <FigureLoop />
            <FigureRun />
          </div>
          <p class="more">
            Every word in a box is defined, in reading order, in{" "}
            <a href="/glossary/">the glossary</a>.
          </p>
        </section>
      )
    }

    {/* The doors: a band, like the evidence strip, because it is a different
        kind of thing from the sections around it — furniture rather than
        writing — and the mantle says so without a box or a shadow. The
        glossary line under the grid is arrangement, not content, same as
        "All the runs, with their figures" below. */}
    {
      isVisible(page.data, "orient") && (
        <section id="orient">
          <p class="secnum" aria-hidden="true">03</p>
          <h2 data-sk-edit="orient.title">{orient.title}</h2>
          <p data-sk-edit="orient.intro">{orient.intro}</p>
          <ul class="doors">
            {doors.map((door, index) => (
              <li>
                <p class="eyebrow" data-sk-edit={`orient.doors[${index}].eyebrow`}>
                  {door.eyebrow}
                </p>
                <p class="blurb" data-sk-edit={`orient.doors[${index}].blurb`}>
                  {door.blurb}
                </p>
                <ul class="destinations">
                  {door.links.map((link) => (
                    <li>
                      <a href={link.href}>
                        <span class="kind">{link.kind}</span>
                        <span class="dest">{link.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="spine">
      <p class="secnum" aria-hidden="true">04</p>
      <h2 data-sk-edit="spine.title">{spine.title}</h2>
      <p data-sk-edit="spine.intro">{spine.intro}</p>
      <EntryList items={concepts} ordinalLabel="Concept" />
    </section>

    <section id="reading">
      <p class="secnum" aria-hidden="true">05</p>
      <h2 data-sk-edit="reading.title">{reading.title}</h2>
      <p data-sk-edit="reading.intro">{reading.intro}</p>
      <EntryList items={articles} ordinalLabel="Article" />
    </section>

    <section id="runs">
      <p class="secnum" aria-hidden="true">06</p>
      <h2 data-sk-edit="runs.title">{runs.title}</h2>
      <p data-sk-edit="runs.intro">{runs.intro}</p>
      <RunCards reports={reports} />
      <p class="corpus" data-sk-edit="runs.corpus">{runs.corpus}</p>
      <p class="more"><a href="/runs/">All the runs, with their figures</a></p>
    </section>

    {/* The one section allowed to face forward. Its copy carries its own
        caveat — intent, not measurement — and the detail lives on /roadmap/,
        where every item names what it waits on. */}
    {
      isVisible(page.data, "next") && (
        <section id="next">
          <p class="secnum" aria-hidden="true">07</p>
          <h2 data-sk-edit="next.title">{next.title}</h2>
          {next.body.map((para, index) => (
            <p data-sk-edit={`next.body[${index}]`}>{para}</p>
          ))}
          <p class="more">
            <a href="/roadmap/">The roadmap, with what each item waits on</a>
          </p>
        </section>
      )
    }

    <section id="ways">
      <p class="secnum" aria-hidden="true">08</p>
      <h2 data-sk-edit="ways.title">{ways.title}</h2>
      <p data-sk-edit="ways.intro">{ways.intro}</p>
      <TagList tags={allTags()} label="" />
    </section>

    {/* A section the owner can turn off. Not rendered when it is off, rather
        than hidden with a class: text still in the HTML is text a search
        engine indexes and anyone reading source can read, which is not what
        "hide this" means to the person asking.

        `isVisible(page.data, "notes")` rather than `notes.visible`, and the
        difference is not style: a flag missing for any reason has to read as
        *shown*. Astro's content cache served a pre-schema parse once while
        this was being written, the plain property was `undefined`, and a whole
        section came off a live page in silence. The wrong answer that shows a
        section gets noticed; the one that deletes it does not.

        A JS comment, not an HTML one, so none of this ships to a visitor. */}
    {
      isVisible(page.data, "notes") && (
        <section id="notes">
          <p class="secnum" aria-hidden="true">09</p>
          <h2 data-sk-edit="notes.title">{notes.title}</h2>
          <p data-sk-edit="notes.body">{notes.body}</p>
          <div class="figures">
            <FigureEvidence />
          </div>
        </section>
      )
    }
  </main>
</Base>

<style>
  /* Wider than the reading measure, and this is the one page where that is
     right. A reading page is a column of prose and 62–72ch is how far an eye
     tracks a line; this page is a column of prose *and* two grids that want
     two or three columns on a laptop.

     The resolution is one left edge, not one centre: prose capped at the
     measure and flush to the same edge the grids run from. The cover and the
     section heads may be display-sized, but the return sweep still goes to
     one place. */
  .home {
    inline-size: min(100%, var(--page-wide));
    margin-inline: auto;
    padding-block: var(--space-xl) var(--space-3xl);
    padding-inline: var(--space-m);
  }

  /* ── the cover ──────────────────────────────────────────────────────────
     Opened by the heaviest rule on the site. Every other page starts with a
     hairline; a cover is allowed one act of weight, and this is it. */
  .cover {
    border-block-start: 4px solid var(--text);
    padding-block-start: var(--space-l);
  }

  .masthead {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .masthead {
      grid-template-columns: 1fr auto;
      column-gap: var(--space-2xl);
    }
  }

  /* The headline, in the display serif — the one place besides the section
     heads the face appears. Capped in ch of its own size so two lines break
     where a cover's lines should, not where the grid happens to end. */
  .cover h1 {
    font-family: var(--display);
    font-weight: var(--weight-medium);
    font-size: var(--text-cover);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    max-inline-size: 16ch;
  }

  /* پایش — the plate. Decorative (the top bar names the site for every
     reader), so it is allowed the accent, which on this page is the vermilion
     a printer would have mixed once and spent carefully. */
  .mark {
    font-family: var(--farsi);
    font-size: var(--text-covermark);
    line-height: 1;
    color: var(--accent);
  }

  .tagline {
    font-size: var(--text-lead);
    color: var(--muted);
    margin-block-start: var(--space-s);
    max-inline-size: var(--measure-narrow);
  }

  /* The paragraph that tells a stranger what they are looking at. Lead size
     here, against the site's own body-size habit, because this page is now a
     cover and a cover's standfirst is display matter — the reading pages keep
     their discipline. Narrow measure in its own ch, so the line stays a line. */
  .standfirst {
    margin-block-start: var(--space-l);
    font-size: var(--text-lead);
    max-inline-size: var(--measure-narrow);
  }

  /* The contents rail: the cover as a contents page in miniature. Three
     columns of three on a laptop, one column on a phone, every row opened by
     a hairline — a printed table of contents, not a nav bar. */
  .contents {
    margin-block-start: var(--space-2xl);
  }

  .contents ol {
    list-style: none;
    padding: 0;
    display: grid;
    column-gap: var(--space-l);
  }

  @media (min-width: 40rem) {
    .contents ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contents li {
    border-block-start: var(--rule);
  }

  .contents a {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding-block: var(--space-xs);
    text-decoration: none;
    color: var(--text);
  }

  .contents .no {
    font-family: var(--mono);
    font-size: var(--text-micro);
    color: var(--accent);
  }

  .contents .sec {
    font-size: var(--text-small);
  }

  .contents a:hover .sec,
  .contents a:focus-visible .sec {
    color: var(--current);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* ── the sections ───────────────────────────────────────────────────────
     Each opened by a heavy ink rule — the page's structure drawn in the
     page's ink, where the inner pages use hairlines — with the number set in
     the display face's italic and the vermilion, in its own margin column on
     a laptop. The number is arrangement, not machine truth, which is exactly
     why it is *not* mono: on this site mono is a promise about where a value
     came from, and these came from nowhere but order. */
  .home section {
    margin-block-start: var(--space-3xl);
    border-block-start: 3px solid var(--text);
    padding-block-start: var(--space-m);
  }

  @media (min-width: 64rem) {
    .home section {
      display: grid;
      grid-template-columns: 6rem 1fr;
      column-gap: var(--space-l);
    }

    /* `:global(*)`, not `*`: a scoped universal selector only matches elements
       carrying this page's scope attribute, and half of a section's children
       are component roots — the findings ledger, the entry lists — which do
       not. Scoped, they fall out of this rule and auto-place into the 6rem
       number column. The .secnum rule below still wins on specificity. */
    .home section > :global(*) {
      grid-column: 2;
    }

    .home section > .secnum {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* Written at the same compound depth as the `> p` rule below, because the
     number IS a p and the muted-intro rule would out-specify a bare .secnum
     and grey the vermilion out. */
  .home section > .secnum {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    color: var(--accent);
    margin-block-end: var(--space-2xs);
  }

  .home section > h2 {
    font-family: var(--display);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    inline-size: min(100%, var(--measure));
  }

  .home section > p {
    color: var(--muted);
    margin-block-start: var(--space-s);
    inline-size: min(100%, var(--measure));
  }

  .corpus {
    margin-block-start: var(--space-l);
  }

  .more {
    margin-block-start: var(--space-s);
  }

  .figures {
    margin-block-start: var(--space-l);
    display: grid;
    gap: var(--space-xl);
  }

  /* The doors are a band, like the evidence strip and for the same reason:
     mantle behind them says "a different kind of thing" without reaching for
     a box or a shadow, and the two bands give the page a rhythm — reading
     surface, band, reading surface — instead of nine sections cut by nine
     identical rules. Same inline padding as the strip, so the two bands
     share an inner edge. */
  #orient {
    background: var(--mantle);
    border-block-end: var(--rule);
    padding-inline: var(--space-s);
    padding-block-end: var(--space-l);
  }

  .doors {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .doors {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .doors > li {
    border-block-start: 2px solid var(--text);
    padding-block-start: var(--space-s);
  }

  /* The eyebrow is the door's question — who the door is for, which is the
     one fact a scanning reader needs before the sentence. In the vermilion,
     because on this page the accent's job is to mark the things a scanning
     eye should catch: numbers, questions, destinations. */
  .doors .eyebrow {
    font-family: var(--mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .doors .blurb {
    margin-block-start: var(--space-2xs);
  }

  .destinations {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xs);
    display: grid;
    gap: var(--space-2xs);
  }

  .destinations a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    text-decoration: none;
    font-size: var(--text-small);
  }

  .destinations .kind {
    font-family: var(--mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  /* The same link idiom as a finding's destination, because it is the same
     kind of promise: underlined in the accent, heavier on hover. */
  .destinations .dest {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .destinations a:hover .dest,
  .destinations a:focus-visible .dest {
    text-decoration-thickness: 2px;
  }

  #ways :global(.tags) {
    margin-block-start: var(--space-m);
  }

  /* The article list is prose in a list's clothing — a title and a sentence —
     so it reads at the measure like everything else rather than stretching a
     one-line summary across the whole page. */
  #reading :global(.entries) {
    inline-size: min(100%, var(--measure));
  }

  /* The ten concepts are the spine and they earn the page's width: two columns
     of five on a laptop, so the whole spine is one eyeful instead of a scroll.
     One column below the site's one breakpoint, same as the findings above it.
     `align-items: start` so a short one-liner does not stretch and hang its
     neighbour's rule in mid-air. */
  #spine :global(.entries) {
    align-items: start;
  }

  @media (min-width: 64rem) {
    #spine :global(.entries) {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-2xl);
    }
  }

  /* On this page the shared lists dress to match the cover: titles in the
     display serif, ordinals in the vermilion. Inner index pages keep the sans
     — this is the jacket, not a new rule. */
  .home :global(.entries .entry-title) {
    font-family: var(--display);
    font-weight: var(--weight-medium);
  }

  .home :global(.entries .ordinal) {
    color: var(--accent);
  }
</style>
