---
/* /articles/<slug>/ — one long-form piece. */
import type { GetStaticPaths } from "astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import FigureBudget from "../../components/FigureBudget.astro";
import FigureCensor from "../../components/FigureCensor.astro";
import FigureChurn from "../../components/FigureChurn.astro";
import FigureCostShape from "../../components/FigureCostShape.astro";
import FigureDenominator from "../../components/FigureDenominator.astro";
import FigureEarlyReturn from "../../components/FigureEarlyReturn.astro";
import FigureGatePath from "../../components/FigureGatePath.astro";
import FigureLedgerGap from "../../components/FigureLedgerGap.astro";
import FigurePassRate from "../../components/FigurePassRate.astro";
import FigureRedCluster from "../../components/FigureRedCluster.astro";
import FigureStageSpike from "../../components/FigureStageSpike.astro";
import LongForm from "../../layouts/LongForm.astro";
import { ordered, readNextOf } from "../../lib/collections.js";

/* Each article's drawings, and where each lands — after the section whose
   argument it draws (owner's ask, 2026-08-13, restated: the articles should
   carry their arguments visually *throughout*, not once per piece).
   Arrangement, not content: the figures show orderings and shapes, never
   values, because a value drawn into an SVG-ish pane would be the one figure
   on the site the evidence gate cannot recompute. Keyed by entry id; an
   article without a row simply reads as prose, so adding a fifth article
   costs nothing here. */
const FIGURES: Record<string, { component: AstroComponentFactory; after: number }[]> = {
  "what-a-run-costs": [
    { component: FigureDenominator, after: 0 },
    { component: FigureCostShape, after: 1 },
    { component: FigureStageSpike, after: 3 }
  ],
  "never-believe-the-agent": [
    { component: FigurePassRate, after: 0 },
    { component: FigureRedCluster, after: 1 },
    { component: FigureGatePath, after: 2 }
  ],
  "the-nudge-below-the-median": [
    { component: FigureBudget, after: 0 },
    { component: FigureCensor, after: 2 },
    { component: FigureChurn, after: 4 }
  ],
  "the-ledger-that-lied": [
    { component: FigureLedgerGap, after: 1 },
    { component: FigureEarlyReturn, after: 3 }
  ]
};

export const getStaticPaths = (async () => {
  const articles = await ordered("articles");
  return articles.map((entry) => ({ params: { entry: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const next = (await readNextOf("articles", entry)).map((other) => ({
  href: `/articles/${other.id}/`,
  title: other.data.title,
  summary: other.data.standfirst
}));
---

<LongForm entry={entry} collection="articles" next={next} figures={FIGURES[entry.id]} />
