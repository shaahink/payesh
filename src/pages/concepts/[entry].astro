---
/* A concept page: the five moves, in the order SPEC Part III sets.
   ---------------------------------------------------------------------------
   The move headings are structure, not copy — every concept page has the same
   five, which is what makes the spine readable as one document — so they live
   here beside the markup that renders them, and their ids are written once and
   handed to both the anchor and the table of contents.

   The evidence strip is last, at the foot, which is where SPEC Part II puts
   it. That is one move out of the order Part III lists the fields in — the
   entry shape has `evidence` before `tryIt` — and the reason to follow Part II
   here is that the strip is the page's conclusion rather than one of its
   paragraphs: the reader has been told the idea, the failure and the mechanism,
   and the last thing on the page is what it actually cost when it ran. `tryIt`
   is two lines and belongs beside the mechanism it demonstrates. */
import type { GetStaticPaths } from "astro";
import EvidenceStrip from "../../components/EvidenceStrip.astro";
import Prose from "../../components/Prose.astro";
import ReadNext from "../../components/ReadNext.astro";
import TagList from "../../components/TagList.astro";
import Reading from "../../layouts/Reading.astro";
import { hrefOf, ordered, readNextOf, termIndex } from "../../lib/collections.js";
import { pageContext } from "../../lib/links.js";

export const getStaticPaths = (async () => {
  const concepts = await ordered("concepts");
  return concepts.map((entry) => ({ params: { entry: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { meta, title, alsoKnownAs, oneLine, theIdea, theProblem, inConductor, tryIt, evidence, tags } =
  entry.data;

/* One context across the page's three prose blocks, and `self` so a concept
   never links its own title or its own other names — the phrases most likely
   to appear in its own paragraphs. */
const terms = await termIndex();
const linking = pageContext(hrefOf("concepts", entry.id));

const next = (await readNextOf("concepts", entry)).map((other) => ({
  href: `/concepts/${other.id}/`,
  title: other.data.title,
  summary: other.data.oneLine
}));

/* One list, read by the anchors and by the table of contents, so the two
   cannot drift apart. */
const moves = [
  { id: "the-idea", text: "The idea" },
  { id: "the-problem", text: "What goes wrong without it" },
  { id: "in-conductor", text: "How Conductor does it" },
  { id: "try-it", text: "Try it" },
  { id: "evidence", text: "Evidence" }
];
const headings = moves.map((move) => ({ depth: 2, slug: move.id, text: move.text }));
---

<Reading
  title={meta.title}
  description={meta.description}
  ogType={meta.ogType}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  canonical={meta.canonical}
  headings={headings}
  editCollection="concepts"
  editEntry={entry.id}
>
  <article class="concept">
    <h1 data-sk-edit="title">{title}</h1>
    <p class="standfirst" data-sk-edit="oneLine">{oneLine}</p>

    {
      alsoKnownAs.length > 0 && (
        <p class="aka">
          <span class="aka-label">Also known as</span>
          {alsoKnownAs.map((name, index) => (
            <span class="aka-name" data-sk-edit={`alsoKnownAs[${index}]`}>
              {name}
            </span>
          ))}
        </p>
      )
    }

    <TagList tags={tags} />

    <h2 id={moves[0]!.id}>{moves[0]!.text}</h2>
    <Prose body={theIdea} terms={terms} context={linking} path="theIdea" />

    <h2 id={moves[1]!.id}>{moves[1]!.text}</h2>
    <Prose body={theProblem} terms={terms} context={linking} path="theProblem" />

    <h2 id={moves[2]!.id}>{moves[2]!.text}</h2>
    <Prose
      body={inConductor.mechanism}
      terms={terms}
      context={linking}
      path="inConductor.mechanism"
    />


    {/* The citations carry no annotation: `inConductor.citations` is on the
        collection's omit list, so there is no field in the editor's form model
        for one, and an annotation naming a path with no field fails the build.
        That is the right answer — a line number in someone else's repository
        is verified against a named commit at S4.4, not typed into a form. */}
    <ul class="citations">
      {
        inConductor.citations.map((cite) => (
          <li>
            <code class="mono">
              {cite.path}:{cite.line}
            </code>
            <span class="cite-note">{cite.note}</span>
          </li>
        ))
      }
    </ul>

    <h2 id={moves[3]!.id}>{moves[3]!.text}</h2>
    <dl class="try-it">
      {
        tryIt.map((step, index) => (
          <Fragment>
            <dt>
              <code class="mono" data-sk-edit={`tryIt[${index}].command`}>
                {step.command}
              </code>
            </dt>
            <dd data-sk-edit={`tryIt[${index}].note`}>{step.note}</dd>
          </Fragment>
        ))
      }
    </dl>

    <EvidenceStrip where={`concepts/${entry.id}.yaml`} evidence={evidence} />

    <ReadNext items={next} />
  </article>
</Reading>

<style>
  .aka {
    font-size: var(--text-small);
    color: var(--muted);
    margin-block-start: var(--space-xs);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .aka-label::after {
    content: ":";
  }

  .aka-name + .aka-name::before {
    content: "· ";
  }

  .concept :global(.tags) {
    margin-block-start: var(--space-m);
  }

  .concept h2 {
    margin-block-start: var(--space-xl);
  }

  .concept p {
    margin-block-start: var(--space-s);
  }

  /* Mono and quiet: a file and a line in someone else's repository is machine
     truth, and the sentence beside it is the only part written for a reader. */
  .citations {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    border-inline-start: var(--rule);
    padding-inline-start: var(--space-s);
    display: grid;
    gap: var(--space-xs);
  }

  /* `anywhere`, because these are paths. A repository path is one unbroken
     word to CSS — `src/Conductor.Core/Orchestration/RunLoop.cs:105` is 423px
     of mono at 13px — and on a 390px phone it pushed the whole page sideways,
     which is the worst version of an overflow: every line of prose on the
     page moves, and nothing on screen shows you why. Breaking mid-path is
     ugly; a horizontal scrollbar on an article is worse. */
  .citations code {
    font-size: var(--text-small);
    color: var(--teal);
    overflow-wrap: anywhere;
  }

  .cite-note {
    display: block;
    font-size: var(--text-small);
    color: var(--muted);
  }

  .try-it {
    margin-block-start: var(--space-m);
    display: grid;
    gap: var(--space-s);
  }

  .try-it dd {
    margin-inline-start: 0;
    color: var(--muted);
    margin-block-start: var(--space-3xs);
  }
</style>
