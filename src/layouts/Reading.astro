---
/* A reading page: one column at the measure, with the in-page table of
   contents sticky beside it on wide viewports. Concept pages and articles are
   this and nothing else (SPEC Part II).

   It wraps Base rather than replacing it, so the head facts, the editor
   annotations, the top bar and the footer stay in exactly one place. A page
   that is not a reading page — the front page, the run index — uses Base
   directly and lays itself out. */
import Base from "./Base.astro";
import Toc, { type Heading } from "../components/Toc.astro";

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogDescription: string;
  ogImage?: string | undefined;
  canonical: string;
  editCollection?: string;
  editEntry?: string;
  /* Straight from Astro's `getHeadings()` or a collection entry's
     `render()` — the same list the page rendered, never a second one. */
  headings?: Heading[];
}

const { headings = [], ...base } = Astro.props;
---

<Base {...base}>
  <slot name="head" slot="head" />

  <div class="reading">
    <main id="main" class="column">
      <slot />
    </main>

    <Toc headings={headings} />
  </div>
</Base>

<style>
  /* Not `.page`: this is two tracks on a wide viewport, so it builds its own
     grid — but out of the same three tokens, so a reading page opens exactly
     where an index page does. Following a link from /concepts/ to a concept
     used to move the headline up 1rem, which is the kind of thing a reader
     feels without being able to name. */
  .reading {
    display: grid;
    /* The one column, stated as a track rather than left to `auto`. An auto
       track sizes to its content and a percentage measured against it is
       indefinite, so `.column`'s own `min(100%, --measure)` had nothing to
       resolve 100% against and fell through to the measure — 440px of column
       inside 342px of phone, and every concept, article and report scrolled
       sideways. The track is what makes the 100% mean something. */
    grid-template-columns: min(100%, var(--measure));
    gap: var(--space-xl);
    padding-block: var(--page-open) var(--page-close);
    padding-inline: var(--page-gutter);
    justify-content: center;
  }

  .column {
    /* min() rather than a bare measure so the column shrinks on a phone
       instead of overflowing it. */
    inline-size: min(100%, var(--measure));
  }

  @media (min-width: 64rem) {
    /* Three tracks, and the two outer ones are `1fr` each so they are always
       exactly equal — which is what puts the prose in the *middle of the
       window*, not in the middle of the column-plus-sidebar pair.

       That pair was the second half of the split between a section index and
       the pages under it: /concepts/ centred its column and a concept centred
       the column and its table of contents together, so following a link
       swung the text 168px to the left. The table of contents lives in the
       right-hand track and the left one is deliberately empty — a margin, the
       way a printed page has one.

       The gap widens here because the outer tracks are now paying for it out
       of the sidebar rather than out of the page's own edges. */
    .reading {
      grid-template-columns: 1fr min(100%, var(--measure)) 1fr;
      column-gap: var(--space-l);
      align-items: start;
    }

    .column {
      grid-column: 2;
    }

    /* `:global`, because a component's root element carries no scope
       attribute of its own and a scoped `.toc` here would never match it. */
    .reading > :global(.toc) {
      grid-column: 3;
      max-inline-size: 15rem;
    }
  }
</style>
