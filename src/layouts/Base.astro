---
/* The shared shell: head, footer, and the review-mode gate. Pages provide the
   content and the per-page head facts; everything a page owner can edit lives
   in src/content, not here.

   Deliberately design-free. The template ships machinery; the site's face —
   layout, palette, type, navigation — is this site's own work, and it should
   look like nothing else in the fleet. */
import { Font } from "astro:assets";
import { absolute } from "@shaahink/sitekit/seo";
import { ogCardFor } from "../lib/seo.js";
import Footer from "../components/Footer.astro";
import TopBar from "../components/TopBar.astro";
import "../styles/styles.css";

/** The site's name, for the tab and the social card.
    ---------------------------------------------------------------------------
    پایش — Persian for monitoring: watching something over time and keeping the
    record of it, which is what this site is made of. Chosen because the shorter
    words that were wanted first were gone: a bare `.vercel.app` label is
    claimed globally and first come, and `conductor-site`, `karvan` (caravan)
    and `rasad` (observation) were each already a stranger's project.

    Here rather than in content, because it is the site's identity rather than
    its copy — renaming it is a decision about the whole thing, not a sentence
    somebody edits in a form. */
const SITE_NAME = "Payesh";

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogDescription: string;
  ogImage?: string | undefined;
  canonical: string;
  /* Which content file this page is showing, for inline editing. A page that
     omits them simply has no inline editing — the gate finds no collection and
     stops, which is the right behaviour for a page assembled from several
     entries rather than a wrong guess about which one to write to. */
  editCollection?: string;
  editEntry?: string;
}

const {
  title,
  description,
  ogType = "website",
  ogDescription,
  ogImage,
  canonical,
  editCollection,
  editEntry
} = Astro.props;

/* Content states paths; the head publishes absolute URLs resolved against
   astro.config's `site` — the one tracked place the origin lives, so a
   domain change never touches this file. Scrapers reject relative
   canonical/og:image anyway. */
const canonicalUrl = absolute(Astro.site!, canonical);

/* Every page gets a card. `meta.ogImage` is the override for a page that has
   earned its own picture; with nothing set, `ogCardFor` hands back the card
   for the section the canonical falls under, so no page can be published with
   a grey box in the feed because somebody forgot a field. There is no page
   here without an og:image, which is why the fallback is a function call
   rather than a default in the schema — a schema default is a value fourteen
   content files would each carry a copy of. src/lib/seo.ts. */
const ogImageUrl = absolute(Astro.site!, ogImage ?? ogCardFor(canonical));

/* ── two notes that belong beside the markup and cannot live there ─────────

   Both are here because a comment in template position has to choose between
   being shipped and being parsed. Astro strips `{/* ... *\/}` and keeps
   `<!-- ... -->`, and five HTML comments in this file were 2,632 bytes on
   every page — 14.6% of one — so they are all Astro comments now. But an
   Astro comment is a JSX expression: it may not sit between </head> and
   <body> (two expressions under one root), and it may not contain an
   angle-bracketed tag, which the checker reads as markup and then loses the
   rest of the file to. Prose about elements, and examples containing them,
   go in the frontmatter.

   **The body's three `data-sk-*` attributes** tell the editor which content
   file this page is showing. `data-sk-editor-path` is /edit here because this
   template builds with format "directory"; a site with format "file" says
   /edit.html.

   **Owner-facing stats (PLAN §3.7).** Once this site has its row in the
   sk-stats instance, import `umamiTag` from "@shaahink/sitekit/analytics" and
   spread it onto an `is:inline` script in the head — cookieless, so no consent
   banner:

       src: "https://sk-stats.vercel.app/script.js"
       websiteId: the id from Settings → Websites

   The sk-stats origin must join script-src and connect-src in astro.config's
   CSP in the same commit. */
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* The site's name after the page's own, which is what a browser tab and a
        search result both want: the page first, because that is what the reader
        is looking for, and the site after it so a row of tabs is attributable.
        Composed here rather than typed into every `meta.title` — that would be
        the same six characters in twenty-one content files, wrong in one of
        them within a month.

        The home page is the exception and is left alone: "Payesh — a field
        guide to agentic engineering · Payesh" is the site's name twice. */}
    <title>{title === SITE_NAME || title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`}</title>

    {/* The two faces, built same-origin. Both preload: the sans carries the
        body from the first paint and the mono carries the wordmark and the
        evidence figures beside it. astro.config's `fonts` block assembles
        each cssVariable; nothing here or in the CSS names a family. */}
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />

    {/* One SVG, both schemes: the mark carries its own prefers-color-scheme
        media query, which is the only theming a favicon gets — it cannot read
        the page's tokens and does not follow the toggle. Without this line
        every tab shows the browser's blank-page glyph (bug #8). */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Two things that have to happen before first paint. The `js` class
        enables progressive-enhancement styles. The second half reads a theme
        the visitor chose *explicitly* and writes it on the root element, so a
        reader who picked light does not get a frame of mocha first.

        It writes nothing when there is no stored choice, on purpose: that
        visitor is following `prefers-color-scheme` through the media query
        in tokens.css, and an unconditional write would freeze their system
        preference at whatever it was on their first visit. localStorage
        throws rather than returning null in a blocked context, hence the
        try.

        Inline and hashed by hand: its sha256 sits in astro.config's CSP
        block — change one, change both, and test/csp.test.mjs fails if you
        change only one. */}
    <script is:inline>document.documentElement.classList.add("js");try{const t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch{}</script>

    {/* Owner-facing stats go here — the shape is in the frontmatter above. */}

    <slot name="head" />
  </head>

  <body
    data-sk-collection={editCollection}
    data-sk-entry={editEntry}
    data-sk-editor-path="/edit"
  >
    {/* The first thing in the tab order, and the only one that has to be:
        every page here puts a top bar of four links ahead of its content, and
        a reader on a keyboard or a switch should not walk them again on every
        page of a twenty-one page site. Hidden until it takes focus, revealed
        where it is — a skip link that is invisible *while focused* is the
        classic version of this control that helps nobody.

        `#main` is the id every layout puts on its one main element;
        `scripts/a11y.mjs` checks over the built output that the target
        actually exists on every page, because a skip link pointing at nothing
        is silent in every browser. */}
    <a class="skip-link" href="#main">Skip to content</a>

    <TopBar />

    <slot />

    <Footer />

    <script>
      import { installThemeToggle } from "../scripts/theme.js";

      /* Bundled, so the CSP needs no new hash and no new origin: the toggle's
         behaviour is a module served from this site like any other. Only the
         one-liner that has to beat first paint is inline. */
      installThemeToggle();

      import "../scripts/review-gate.js";
      /* Inline editing's gate — the same shape as review-gate.js, and the only
         inline-editing code a public visitor ever runs. It reads ?edit=1 and
         dynamically imports the editor only for someone who asked; the public
         downloads this import statement and nothing else, which is why the
         public pages' CSP needs no Google origin, no new connect-src and no
         new style-src. The panel it defers to is entirely in the kit.

         Called rather than bare-imported: the kit is `sideEffects: false`, so
         a bare import of a side-effecting module is tree-shaken away to
         nothing and the gate silently never runs. */
      import { installInlineEditor } from "@shaahink/sitekit/editor/inline-gate";

      installInlineEditor();
    </script>
  </body>
</html>
