{
  "name": "payesh",
  "private": true,
  "type": "module",
  "description": "Payesh — a field guide to agentic engineering, worked end to end in Conductor: ten concepts, four articles, and anonymised reports from real autonomous runs. Astro 7, content in typed collections; the shared machinery comes from @shaahink/sitekit.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node --test \"test/**/*.test.mjs\"",
    "harvest": "node scripts/harvest.mjs",
    "sync": "node scripts/sync.mjs",
    "evidence": "node scripts/harvest.mjs --check",
    "evidence:cited": "node scripts/harvest.mjs --cited",
    "anonymity": "node scripts/anonymity.mjs",
    "anonymity:shapes": "node scripts/anonymity.mjs --shapes",
    "a11y": "node scripts/a11y.mjs",
    "seo": "node scripts/seo.mjs",
    "seo:cards": "node scripts/seo.mjs --cards",
    "test": "node --test \"test/**/*.test.mjs\"",
    "headers": "sitekit-headers",
    "content": "sitekit-normalize",
    "editor": "sitekit-editor-css"
  },
  "dependencies": {
    "@shaahink/sitekit": "0.27.0",
    "astro": "7.1.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
